# Copy this file to .env inside lead-finder/ or email-drafter/ and fill in your own values.
# Never commit the real .env file.

# LLM used by the agents
OPENAI_API_KEY=

# Google search via https://serper.dev (free plan: 2,500 searches) - lead-finder only
SERPER_API_KEY=

# CrewAI platform token - needed to use the Google Sheets integration when running locally
# (app.crewai.com -> Settings -> Integrations)
CREWAI_PLATFORM_INTEGRATION_TOKEN=
